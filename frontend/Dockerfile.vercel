FROM node:24-slim AS frontend
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . ./
RUN VITE_LIVE_BACKEND=true npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng tesseract-ocr-osd tesseract-ocr-fra tesseract-ocr-spa tesseract-ocr-deu ca-certificates && rm -rf /var/lib/apt/lists/*
RUN useradd --uid 10001 --create-home invoice
WORKDIR /app
COPY vendor/*.whl /wheels/
RUN pip install /wheels/*.whl 'psycopg[binary]>=3.2,<4' 'psycopg-pool>=3.2,<4' 'vercel-blob>=0.5,<1'
COPY --from=frontend /build/dist ./frontend-dist
USER invoice
ENV INVOICE_CLOUD=vercel PORT=8000
CMD ["sh","-c","exec python -m uvicorn invoice_intelligence.cloud.app:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
