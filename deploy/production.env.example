INVOICE_DOMAIN=invoices.example.com
INVOICE_DEPLOYMENT=production
INVOICE_PUBLIC_ORIGIN=https://invoices.example.com
INVOICE_ALLOWED_HOSTS=invoices.example.com,localhost,127.0.0.1
INVOICE_AUTH_FILE=/run/invoice-secrets/accounts.json
INVOICE_DATA_DIR=/data
EXTRACTION_PROVIDER=groq
GROQ_API_KEY=configure_locally
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_DOCUMENT_BUDGET_USD=0.15
GROQ_MAX_TOKENS=950
GROQ_MIN_INTERVAL=65
INVOICE_PROCESS_TIMEOUT=600
OCR_ENHANCED=true
OCR_LANGUAGES=eng
