# Copy to .env. Read automatically; existing shell variables take precedence.
# Never commit .env. Existing invoices are not automatically sent to Groq.
INVOICE_DATA_DIR=./data/runtime
INVOICE_MAX_UPLOAD_BYTES=20971520
INVOICE_MAX_PAGES=10
INVOICE_MAX_PIXELS=25000000
TESSERACT_CMD=tesseract
OCR_LANGUAGES=eng
OCR_ENHANCED=true
EXTRACTION_PROVIDER=groq
GROQ_API_KEY=configure_locally
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT=35
GROQ_MAX_TOKENS=950
GROQ_DOCUMENT_BUDGET_USD=0.15
# Estimates; verify current model prices against your account's billing.
GROQ_INPUT_PRICE_PER_MILLION=0.80
GROQ_OUTPUT_PRICE_PER_MILLION=4.00
# Optional local accounts; required for production. See deploy/README.md.
# INVOICE_AUTH_FILE=./.secrets/accounts.json
INVOICE_DEPLOYMENT=local
# Set EXTRACTION_PROVIDER=local to use OCR/rules with no external calls.
